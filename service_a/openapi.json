  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "balances": {
            "items": {
              "$ref": "#/components/schemas/BalanceOut"
            },
            "type": "array",
            "title": "Balances"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "username",
          "balances"
        ],
        "title": "AccountOut"
      },
      "BalanceOut": {
        "properties": {
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "available": {
            "type": "string",
            "title": "Available"
          },
          "held": {
            "type": "string",
            "title": "Held"
          },
          "total": {
            "type": "string",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "asset",
          "available",
          "held",
          "total"
        ],
        "title": "BalanceOut"
      },
      "CandleOut": {
        "properties": {
          "t": {
            "type": "integer",
            "title": "T"
          },
          "o": {
            "type": "string",
            "title": "O"
          },
          "h": {
            "type": "string",
            "title": "H"
          },
          "l": {
            "type": "string",
            "title": "L"
          },
          "c": {
            "type": "string",
            "title": "C"
          },
          "v": {
            "type": "string",
            "title": "V"
          }
        },
        "type": "object",
        "required": [
          "t",
          "o",
          "h",
          "l",
          "c",
          "v"
        ],
        "title": "CandleOut"
      },
      "CandlesOut": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "interval": {
            "type": "string",
            "enum": [
              "5s",
              "15s",
              "1m",
              "5m"
            ],
            "title": "Interval"
          },
          "candles": {
            "items": {
              "$ref": "#/components/schemas/CandleOut"
            },
            "type": "array",
            "title": "Candles"
          },
          "watermark": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Watermark"
              },
              {
                "type": "null"
              }
            ]
          },
          "replace_all": {
            "type": "boolean",
            "title": "Replace All"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "interval",
          "candles",
          "watermark",
          "replace_all"
        ],
        "title": "CandlesOut"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "DepositIn": {
        "properties": {
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "asset",
          "amount"
        ],
        "title": "DepositIn"
      },
      "DepositOut": {
        "properties": {
          "deposit_id": {
            "type": "integer",
            "title": "Deposit Id"
          },
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "balance": {
            "$ref": "#/components/schemas/BalanceOut"
          }
        },
        "type": "object",
        "required": [
          "deposit_id",
          "asset",
          "amount",
          "balance"
        ],
        "title": "DepositOut"
      },
      "ErrorOut": {
        "properties": {
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "message"
        ],
        "title": "ErrorOut"
      },
      "FillListOut": {
        "properties": {
          "fills": {
            "items": {
              "$ref": "#/components/schemas/FillOut"
            },
            "type": "array",
            "title": "Fills"
          }
        },
        "type": "object",
        "required": [
          "fills"
        ],
        "title": "FillListOut"
      },
      "FillOut": {
        "properties": {
          "b_day": {
            "type": "string",
            "title": "B Day"
          },
          "b_seq": {
            "type": "integer",
            "title": "B Seq"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Side"
          },
          "role": {
            "type": "string",
            "enum": [
              "TAKER",
              "MAKER"
            ],
            "title": "Role"
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "qty": {
            "type": "string",
            "title": "Qty"
          },
          "ts": {
            "type": "integer",
            "title": "Ts"
          }
        },
        "type": "object",
        "required": [
          "b_day",
          "b_seq",
          "order_id",
