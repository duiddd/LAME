    "/api/market/candles": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Candles",
        "operationId": "candles_api_market_candles_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "5s",
                "15s",
                "1m",
                "5m"
              ],
              "type": "string",
              "default": "15s",
              "title": "Interval"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 300,
              "title": "Limit"
            }
          },
          {
            "name": "after_day",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
