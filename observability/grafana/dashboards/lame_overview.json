{
  "id": null,
  "uid": "lame-overview",
  "title": "LAME System & AI Observability",
  "tags": ["lame", "comp41720", "red", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (RPS) by Service",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(lame_a_http_request_duration_seconds_count[1m]))", "legendFormat": "Service A (HTTP)" },
        { "refId": "B", "expr": "sum(rate(lame_b_commands_total[1m]))", "legendFormat": "Service B (Commands)" },
        { "refId": "C", "expr": "sum(rate(lame_c_http_requests_total[1m]))", "legendFormat": "Service C (HTTP)" },
        { "refId": "D", "expr": "(sum(rate(lame_d_decisions_total[1m])) or vector(0)) + (sum(rate(lame_d_refused_total[1m])) or vector(0))", "legendFormat": "Service D (Orders)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors & Refusals (Rate/s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(lame_a_orders_total{result=~\"SYSTEM_BUSY|NO_FRESH_PRICE\"}[1m])) or vector(0)", "legendFormat": "Service A Orders Refused (D or B unavailable)" },
        { "refId": "E", "expr": "sum(rate(lame_a_http_request_duration_seconds_count{status=~\"5..\"}[1m])) or vector(0)", "legendFormat": "Service A HTTP 5xx" },
        { "refId": "B", "expr": "rate(lame_b_bad_frames_total[1m]) + rate(lame_b_outbound_overflows_total[1m])", "legendFormat": "Service B Frame/Overflow Errors" },
        { "refId": "C", "expr": "sum(rate(lame_c_http_errors_total[1m]))", "legendFormat": "Service C HTTP 4xx/5xx" },
        { "refId": "D", "expr": "sum(rate(lame_d_refused_total[1m])) or vector(0)", "legendFormat": "Service D 503 Refusals" },
        { "refId": "F", "expr": "sum(rate(lame_d_decisions_total{decision=\"REJECTED\"}[1m])) or vector(0)", "legendFormat": "Service D Risk Rejections (REJECTED)" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95 (Seconds) — Services A, D, C",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(lame_a_http_request_duration_seconds_bucket[1m])))", "legendFormat": "Service A HTTP p95" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(lame_a_order_completion_seconds_bucket[1m])))", "legendFormat": "Service A Order Completion p95" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(lame_d_decision_seconds_bucket[1m])))", "legendFormat": "Service D Risk Decision p95" },
        { "refId": "D", "expr": "histogram_quantile(0.95, sum by (le) (rate(lame_c_chat_latency_seconds_bucket[1m])))", "legendFormat": "Service C RAG End-to-End p95" },
        { "refId": "E", "expr": "histogram_quantile(0.95, sum by (le) (rate(lame_c_llm_inference_duration_seconds_bucket[1m])))", "legendFormat": "Service C Ollama Inference p95" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI Token Usage & Refusal Rate (Service C)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "lame_c_tokens_total{type=\"prompt\"}", "legendFormat": "Prompt Tokens" },
        { "refId": "B", "expr": "lame_c_tokens_total{type=\"eval\"}", "legendFormat": "Eval Tokens" },
        { "refId": "C", "expr": "lame_c_tokens_saved_by_gates_total", "legendFormat": "Tokens Saved by Gates" },
        { "refId": "D", "expr": "sum(lame_c_refusal_total)", "legendFormat": "Total Refusals" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "AI Estimated Reference Token Cost (USD)",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "lame_c_estimated_token_cost_usd{mode=\"reference_baseline\"}", "legendFormat": "Equiv USD Baseline" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service C DLQ & Stripped Citations",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "lame_c_rabbitmq_dlq_messages_count", "legendFormat": "RabbitMQ DLQ" },
        { "refId": "B", "expr": "lame_c_hallucinated_citations_stripped_total", "legendFormat": "Stripped Citations" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Service A Circuit Breaker & Shedding",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "lame_a_circuit_state", "legendFormat": "Circuit State (0=C,1=HO,2=O)" },
        { "refId": "B", "expr": "lame_a_shedding_active", "legendFormat": "Shedding Active" }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Service D Ready & Service B Subscribers",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "lame_d_ready", "legendFormat": "D Ready" },
        { "refId": "B", "expr": "lame_b_md_subscribers", "legendFormat": "B MD Subscribers" }
      ]
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Service Up (Prometheus Scrape)",
      "description": "Whether Prometheus could scrape each service's /metrics. A red stretch is an outage.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }]
        },
        "overrides": []
      },
      "options": { "showValue": "never", "mergeValues": true, "legend": { "showLegend": false } },
      "targets": [
        { "refId": "A", "expr": "max by (job) (up)", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Settlement Pipeline (A <- D outbox)",
      "description": "Notifications waiting in D's outbox for A, A's orders sent without a reply (funds held), and A's finished orders still waiting for a trade. All should return to 0.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "lame_d_outbox_backlog", "legendFormat": "D notifications waiting for A" },
        { "refId": "B", "expr": "sum(lame_a_orders_by_status{status=\"UNKNOWN\"}) or vector(0)", "legendFormat": "A orders in doubt (UNKNOWN)" },
        { "refId": "C", "expr": "lame_a_orders_unsettled", "legendFormat": "A finished orders not yet settled" }
      ]
    }
  ]
}
